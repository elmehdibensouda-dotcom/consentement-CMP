AMAN_ENVIRONMENT=staging
AMAN_PORT=8000
AMAN_DATABASE_URL_FILE=/run/secrets/AMAN_DATABASE_URL
AMAN_RATE_LIMIT_HASH_KEY_FILE=/run/secrets/AMAN_RATE_LIMIT_HASH_KEY
AMAN_CORS_ORIGINS=https://console.example.ma
# IP ou CIDR du reverse proxy TLS, seul autorisé à transmettre X-Forwarded-For.
# Laisser vide si l'API n'est pas derrière un proxy. '*' est refusé.
AMAN_TRUSTED_PROXY_IPS=10.0.0.0/24
